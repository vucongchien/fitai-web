{
  "name": "fitai-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint -f agent --nextjs-plugin .",
    "lint:fix": "oxlint -f agent --nextjs-plugin --fix .",
    "format": "oxfmt --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "proto:gen": "buf generate ../gym-companion/proto --template buf.gen.yaml"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@bufbuild/protobuf": "2.13.0",
    "@connectrpc/connect": "2.1.2",
