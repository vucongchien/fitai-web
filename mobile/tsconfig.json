{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "esnext"],
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@/*": ["../src/*", "./src/*"],
      "@mobile/*": ["./src/*"],
      "@shared-domain/*": ["../src/features/workout/domain/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../src/features/workout/domain/**/*.ts",
    "../src/shared/design-system/**/*.ts",
    "../src/shared/ui/charts/use-circular-progress.ts"
  ]
}
