{
  "display_name": "Shoulder Press",
  "rep_type": "counted",
  "ready_gate_frames": 3,
  "min_rep_duration_ms": 1000,
  "posture_gate": "reject_low_hands",
  "notes": "Bài tập đẩy vai qua đầu. Bắt đầu từ ngang vai (góc khuỷu tay ≤105°) và đẩy thẳng lên qua đầu (≥140°).",
  "phase_detection": {
    "metric": "elbow_angle",
    "thresholds": {
      "rest": {
        "lte": 105,
        "comment": "Vị trí chuẩn bị ngang vai (khuỷu tay gập ≤105°)"
      },
      "transition": {
        "gt": 105,
        "lt": 140,
        "comment": "Đang đẩy tạ lên hoặc hạ tạ xuống"
      },
      "active": {
        "gte": 140,
        "comment": "Đỉnh rep: Tay đẩy thẳng qua đầu (≥140°)"
      }
    },
    "calculation": {
      "landmarks": ["Shoulder (P5, P6)", "Elbow (P7, P8)", "Wrist (P9, P10)"],
      "formula": "θ = arccos((U · W) / (||U|| * ||W||)) * (180 / π)"
    }
  },
  "rules": [
    {
      "metric": "wrist_symmetry",
      "description": "Chênh lệch độ cao hai tay khi đẩy vai",
      "evaluation_type": "upper_bound",
      "apply_in_phases": ["active"],
      "apply_for_view": "front",
      "ranges": [
        {
          "severity": 0,
          "status": "Correct",
          "min": 0.0,
          "max": 0.28
        },
        {
          "severity": 1,
          "status": "Warning",
          "min": 0.28,
          "max": 0.40
        },
        {
          "severity": 2,
          "status": "Danger",
          "min": 0.40,
          "max": null
        }
      ],
      "calculation": {
        "landmarks": ["Left Wrist (P9)", "Right Wrist (P10)"],
        "formula": "wrist_symmetry = |Y_wrist_left - Y_wrist_right| / torso_length"
      }
    },
    {
      "metric": "spine_sway_angle",
      "description": "Ngửa lưng quá mức khi đẩy tạ qua đầu",
      "evaluation_type": "upper_bound",
      "apply_in_phases": ["transition", "active"],
      "apply_for_view": "all",
      "ranges": [
        {
          "severity": 0,
          "status": "Correct",
          "min": 0.0,
          "max": 18.0
        },
        {
          "severity": 1,
          "status": "Warning",
          "min": 18.0,
          "max": 25.0
        },
        {
          "severity": 2,
          "status": "Danger",
          "min": 25.0,
          "max": null
        }
      ],
      "calculation": {
        "landmarks": ["Shoulder (P5, P6)", "Hip (P11, P12)"],
        "formula": "spine_sway_angle = atan2(|X_shoulder - X_hip|, |Y_shoulder - Y_hip|) * (180 / π)"
      }
    }
  ]
}
