{
  "display_name": "Plank",
  "rep_type": "timed",
  "posture_gate": "reject_upright",
  "notes": "Bài tập giữ tĩnh tính thời gian. Yêu cầu toàn bộ cơ thể tạo thành một đường thẳng từ vai qua hông đến cổ chân, khuỷu tay chống vuông góc.",
  "phase_detection": {
    "metric": "body_incline_angle",
    "thresholds": {
      "idle": {
        "gt": 35.0,
        "comment": "Thân người nghiêng > 35° so với phương ngang (chưa vào tư thế Plank) -> Tạm dừng tính giờ"
      },
      "always": {
        "lte": 35.0,
        "comment": "Thân người nằm ngang sàn (≤ 35°) -> Kích hoạt đánh giá form và tính giờ giữ Plank"
      }
    },
    "calculation": {
      "landmarks": ["Shoulder (P5, P6)", "Ankle (P15, P16)"],
      "formula": "θ_incline = |arctan2(Y_shoulder_mid - Y_ankle_mid, X_shoulder_mid - X_ankle_mid)| * (180 / π)",
      "description": "Góc nghiêng của trục cơ thể (Vai - Cổ chân) so với phương ngang"
    }
  },
  "rules": [
    {
      "metric": "body_incline_angle",
      "description": "Góc nghiêng cơ thể so với phương nằm ngang",
      "evaluation_type": "upper_bound",
      "apply_in_phases": ["always"],
      "apply_for_view": "side, oblique",
      "ranges": [
        { "severity": 0, "status": "Correct", "min": 0.0, "max": 28.0 },
        { "severity": 1, "status": "Warning", "min": 28.0, "max": 38.0 },
        { "severity": 2, "status": "Danger", "min": 38.0, "max": null }
      ],
      "calculation": {
        "landmarks": ["Shoulder (P5, P6)", "Ankle (P15, P16)"],
        "formula": "body_incline_angle = |arctan2(Y_shoulder_mid - Y_ankle_mid, X_shoulder_mid - X_ankle_mid)| * (180 / π)"
      }
    },
    {
      "metric": "signed_hip_y_diff",
      "description": "Độ lệch hông có dấu (Dương > +0.125: Võng lưng sập hông; Âm < -0.42: Chổng mông cao)",
      "evaluation_type": "two_sided",
      "apply_in_phases": ["always"],
      "apply_for_view": "side, oblique",
      "ranges": [
        { "severity": 0, "status": "Correct", "min": -0.42, "max": 0.125, "comment": "Thân người giữ thẳng và siết core chuẩn" },
        { "severity": 1, "status": "Warning", "min": -0.55, "max": 0.20, "comment": "Hông bắt đầu võng xuống hoặc nhô cao" },
        { "severity": 2, "status": "Danger", "min": null, "max": null, "comment": "Võng thắt lưng hoặc chổng mông nặng" }
      ],
      "calculation": {
        "landmarks": ["Shoulder (P5, P6)", "Hip (P11, P12)", "Ankle (P15, P16)"],
        "formula": "signed_hip_y_diff = signed_line_deviation(P_shoulder, P_hip, P_ankle) / torso_length"
      }
    },
    {
      "metric": "hand_width_ratio",
      "description": "Độ rộng đặt hai khuỷu tay so với độ rộng vai",
      "evaluation_type": "two_sided",
      "apply_in_phases": ["always"],
      "apply_for_view": "front",
      "ranges": [
        { "severity": 0, "status": "Correct", "min": 0.70, "max": 2.10 },
        { "severity": 1, "status": "Warning", "min": 0.55, "max": 2.30 },
        { "severity": 2, "status": "Danger", "min": 0.0, "max": null }
      ],
      "calculation": {
        "landmarks": ["Shoulder (P5, P6)", "Elbow (P7, P8)"],
        "formula": "hand_width_ratio = |X_elbow_left - X_elbow_right| / |X_shoulder_left - X_shoulder_right|"
      }
    }
  ]
}
