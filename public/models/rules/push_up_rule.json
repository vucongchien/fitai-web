{
  "display_name": "Push-up",
  "rep_type": "counted",
  "posture_gate": "reject_upright",
  "min_eccentric_duration_ms": 0,
  "min_rep_duration_ms": 700,
  "notes": "Bài tập hít đất. Thân người thẳng từ vai xuống cổ chân, hạ ngực sát sàn khuỷu tay ≤98°.",
  "phase_detection": {
    "metric": "elbow_angle",
    "thresholds": {
      "rest": {
        "gt": 148,
        "comment": "Tay chống thẳng ở vị trí cao"
      },
      "transition": {
        "gt": 98,
        "lte": 148,
        "comment": "Đang hạ ngực xuống hoặc đẩy người lên"
      },
      "active": {
        "lte": 98,
        "comment": "Đáy Push-up (ngực hạ sát sàn)"
      }
    },
    "calculation": {
      "landmarks": ["Shoulder (P5, P6)", "Elbow (P7, P8)", "Wrist (P9, P10)"],
      "formula": "θ = arccos((U · W) / (||U|| * ||W||)) * (180 / π)",
      "description": "Góc gập khớp khuỷu tay"
    }
  },
  "rules": [
    {
      "metric": "signed_hip_y_diff",
      "description": "Độ lệch hông có dấu (Dương > +0.035: Võng lưng sập hông; Âm < -0.45: Chổng mông cao / Gục đầu)",
      "evaluation_type": "two_sided",
      "apply_in_phases": ["rest", "transition", "active"],
      "apply_for_view": "side",
      "ranges": [
        {
          "severity": 0,
          "status": "Correct",
          "min": -0.65,
          "max": 0.13,
          "comment": "Thân người giữ thẳng và siết core chuẩn"
        },
        {
          "severity": 1,
          "status": "Warning",
          "min": -0.80,
          "max": 0.22,
          "comment": "Hông bắt đầu võng xuống hoặc nhô quá cao"
        },
        {
          "severity": 2,
          "status": "Danger",
          "min": null,
          "max": null,
          "comment": "Võng thắt lưng hoặc chổng mông/gục đầu nặng"
        }
      ],
      "calculation": {
        "landmarks": ["Shoulder (P5, P6)", "Hip (P11, P12)", "Ankle (P15, P16)"],
        "formula": "signed_hip_y_diff = signed_line_deviation(P_shoulder, P_hip, P_ankle) / torso_length"
      }
    },
    {
      "metric": "hand_width_ratio",
      "description": "Độ rộng hai bàn tay và độ mở khuỷu tay so với độ rộng hai vai ở góc nhìn trước",
      "evaluation_type": "two_sided",
      "apply_in_phases": ["rest"],
      "apply_for_view": "front",
      "ranges": [
        {
          "severity": 0,
          "status": "Correct",
          "min": 0.0,
          "max": 2.15
        },
        {
          "severity": 1,
          "status": "Warning",
          "min": 0.0,
          "max": 2.35
        },
        {
          "severity": 2,
          "status": "Danger",
          "min": 0.0,
          "max": null
        }
      ],
      "calculation": {
        "landmarks": ["Shoulder (P5, P6)", "Wrist (P9, P10)"],
        "formula": "hand_width_ratio = |X_wrist_left - X_wrist_right| / |X_shoulder_left - X_shoulder_right|"
      }
    }
  ]
}
